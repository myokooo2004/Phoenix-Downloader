<?xml version="1.0" encoding="utf-8"?>
<!-- Root is a FrameLayout: the search bar is an OVERLAY on top of the
     content column (which reserves its height with a spacer). Hiding the
     bar therefore never re-layouts the list — the measured cause of the
     Home scroll jank (bar toggles shifted content by ~66dp, 2026-10-20
     frame analysis). The bar also got slimmer (40dp) with a smaller font
     (user, 2026-10-20). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Reserves the overlaid search bar's space: 14 top + 40 bar + 14 bottom -->
        <View
            android:layout_width="match_parent"
            android:layout_height="68dp" />

        <!-- Sites row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/site_youtube"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Youtube"
                    android:src="@drawable/ic_site_youtube" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Youtube"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/site_facebook"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Facebook"
                    android:src="@drawable/ic_site_facebook" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Facebook"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/site_tiktok"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="TikTok"
                    android:src="@drawable/ic_site_tiktok" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="TikTok"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- The RecyclerView IS the scroller: its OnScrollListener drives
             both search-bar hide/show and infinite-scroll pagination. It
             must NOT be wrapped in a ScrollView/NestedScrollView (that
             starved the listener before). -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_videos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="84dp" />
    </LinearLayout>

    <!-- Search bar OVERLAY (slides up to hide; never affects layout) -->
    <LinearLayout
        android:id="@+id/search_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:focusable="false"
                android:fontFamily="@font/padauk"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="textUri"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_open_downloads"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_search"
            android:contentDescription="@string/nav_downloads"
            android:src="@drawable/ic_download" />
    </LinearLayout>
</FrameLayout>
