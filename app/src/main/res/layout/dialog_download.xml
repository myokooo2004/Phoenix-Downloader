<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_sheet">

    <!-- Top card: thumbnail + title + rename -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:background="#E0E0E0">

            <ImageView
                android:id="@+id/iv_dlg_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_media_play"
                android:alpha="0.9" />

            <TextView
                android:id="@+id/tv_dlg_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="3dp"
                android:background="#99000000"
                android:padding="2dp"
                android:textColor="@color/white"
                android:textSize="8sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_dlg_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_dlg_rename"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Rename"
                android:textColor="#2196F3"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Path row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:padding="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_download_red"
            android:contentDescription="Download" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_dlg_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Path:/storage/em...dMate/download/"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="middle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tv_dlg_storage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="129.2GB FREE/224.5GB"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp" />

                <ProgressBar
                    android:id="@+id/pb_dlg_storage"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:progress="40" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_dlg_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Change"
            android:textColor="#2196F3"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_fetching"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/fetching_formats"
        android:visibility="gone" />

    <!-- ONE RecyclerView holds section headers + all format rows and does
         its own scrolling. (Previously a ScrollView wrapped two RecyclerViews:
         the ScrollView measured at full content height, clipped the sheet,
         hid the DOWNLOAD button and made the list unscrollable.) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_formats"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <!-- Fixed DOWNLOAD button at bottom: outside the scrolling list, in a
         match_parent-height root, so it is always visible. A TextView (not a
         Material Button) so its rendering is fully deterministic — no
         inflater/tint machinery between the layout and the pixels. -->
    <TextView
        android:id="@+id/btn_download"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_btn_download"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/download"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
